// FarmaVida Next — Prisma schema (PostgreSQL / Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexão da aplicação: usa o pooler do Neon (pgbouncer).
  url       = env("DATABASE_URL")
  // Conexão direta (sem pooler) — usada pelo Prisma só nas migrations.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────── Enums ───────────────────────────
enum Role {
  CUSTOMER
  ADMIN
}

/// Perfil operacional do staff (só faz sentido quando role = ADMIN).
/// null nunca concede privilégios administrativos.
enum StaffProfile {
  OWNER
  PHARMACIST
  STOCKIST
  ATTENDANT
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELED
}

enum PaymentProvider {
  STRIPE
  PIX
  CASH
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  /// Valor ou moeda recebidos divergem do total do pedido. O dinheiro pode estar
  /// retido no provedor: nada de automático confirma, cancela ou expira um
  /// pagamento neste estado — só a conciliação manual em /admin/financeiro.
  QUARANTINED
  REFUND_PENDING
  REFUND_FAILED
  REFUNDED
}

enum PrescriptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENT
  FIXED
}

enum PharmacyType {
  MATRIZ
  FILIAL
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum StorageDeletionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PolicyKind {
  TERMS_ACCEPTANCE
  PRIVACY_ACKNOWLEDGEMENT
}

enum InventoryMovementKind {
  MANUAL_ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  SALE
  CANCELLATION
  RETURN
  RECEIPT
  LOSS
  SYNC
  RESERVATION
  RELEASE
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  COMPLETED
  CANCELED
}

enum ReturnReason {
  WITHDRAWAL
  DAMAGED
  WRONG_ITEM
  QUALITY
  OTHER
}

enum DeliveryProofMethod {
  RECIPIENT
  CONCIERGE
  SAFE_PLACE
  PICKUP
}

enum InventoryReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
}

enum StripeEventStatus {
  PROCESSING
  PROCESSED
  FAILED
}

enum ReturnRefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

// ─────────────────────────── Usuário ───────────────────────────
model User {
  id                 String        @id @default(cuid())
  name               String
  email              String        @unique
  passwordHash       String
  role               Role          @default(CUSTOMER)
  /// Perfil operacional do staff. null sempre falha fechado.
  staffProfile       StaffProfile?
  cpf                String?
  phone              String?
  /// Versão persistente do login: qualquer incremento invalida todos os JWTs antigos.
  sessionVersion     Int           @default(0)
  /// Segredo TOTP cifrado com AES-GCM. Nunca é enviado ao cliente após a ativação.
  mfaSecretEncrypted String?       @db.Text
  mfaEnabledAt       DateTime?
  // Unidade à qual um admin pertence. Null em clientes. Admin cuja unidade é
  // MATRIZ tem escopo "global" (vê/gere todas as unidades).
  pharmacyId         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  addresses         Address[]
  orders            Order[]
  reviews           Review[]
  prescriptions     Prescription[]
  loyalty           LoyaltyAccount?
  carts             Cart[]
  resetTokens       PasswordResetToken[]
  favorites         Favorite[]
  auditLogs         AuditLog[]
  subscriptions     Subscription[]
  returnRequests    ReturnRequest[]
  couponRedemptions CouponRedemption[]
  mfaRecoveryCodes  MfaRecoveryCode[]
  policyAcceptances PolicyAcceptance[]
  pharmacy          Pharmacy?            @relation(fields: [pharmacyId], references: [id])

  @@index([role])
  @@index([pharmacyId])
  dataExports DataExportRequest[]
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model PolicyAcceptance {
  id         String     @id @default(cuid())
  userId     String
  kind       PolicyKind
  version    String
  acceptedAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, version])
  @@index([userId, acceptedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String   @default("Casa")
  recipient  String
  zip        String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// ─────────────────────────── Catálogo ───────────────────────────
model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  icon     String?
  emoji    String?
  sort     Int       @default(0)
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

/// Política MIP-only garantida no banco: ver a constraint
/// `Product_prescription_never_active` (migration 20260902000200).
model Product {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  description          String   @db.Text
  shortDescription     String?  @db.Text
  emoji                String?
  sku                  String?  @unique
  ean                  String?  @unique
  price                Decimal  @db.Decimal(12, 2)
  /// Custo de aquisição — base do CMV, da margem e da curva ABC por valor.
  costPrice            Decimal? @db.Decimal(12, 2)
  promoPrice           Decimal? @db.Decimal(12, 2)
  requiresPrescription Boolean  @default(false)
  isGeneric            Boolean  @default(false)
  activeIngredient     String?
  rating               Float    @default(0)
  ratingCount          Int      @default(0)
  active               Boolean  @default(true)
  featured             Boolean  @default(false)
  categoryId           String
  brandId              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  category              Category               @relation(fields: [categoryId], references: [id])
  brand                 Brand?                 @relation(fields: [brandId], references: [id])
  images                ProductImage[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  reviews               Review[]
  favoritedBy           Favorite[]
  inventory             Inventory[]
  subscriptions         Subscription[]
  inventoryLots         InventoryLot[]
  inventoryReservations InventoryReservation[]

  @@index([categoryId])
  @@index([brandId])
  @@index([active, featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String  @db.Text
  alt       String?
  sort      Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─────────────────────────── Carrinho ───────────────────────────
model Cart {
  id           String   @id @default(cuid())
  userId       String?
  sessionToken String?  @unique
  // Unidade que o cliente está comprando (estoque é por unidade). Null = ainda
  // não escolheu; a leitura usa a unidade padrão (matriz) como fallback.
  pharmacyId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  pharmacy Pharmacy?  @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([userId])
  @@index([pharmacyId])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  qty       Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
}

// ─────────────────────────── Pedidos ───────────────────────────
model Order {
  id                   String      @id @default(cuid())
  number               String      @unique
  userId               String
  status               OrderStatus @default(PENDING)
  // INERTE desde a remoção do fluxo de receita: createOrder não grava mais este
  // campo, então fica sempre false nos pedidos novos. Mantido só pelo histórico
  // (pedidos antigos). NÃO usar como filtro de "pedido com receita".
  requiresPrescription Boolean     @default(false)
  subtotal             Decimal     @db.Decimal(12, 2)
  discount             Decimal     @default(0) @db.Decimal(12, 2)
  shipping             Decimal     @default(0) @db.Decimal(12, 2)
  total                Decimal     @db.Decimal(12, 2)
  // Modalidade de entrega escolhida no checkout: "standard" (frete padrão) ou
  // "express" (prioridade operacional, taxa fixa + por km; sem promessa fixa).
  deliveryMethod       String      @default("standard")
  paymentMethod        String?
  couponCode           String?
  // Chave opaca da tentativa de checkout. Impede que dois POSTs concorrentes
  // do mesmo formulário criem/cobrem pedidos diferentes.
  checkoutKey          String?     @unique
  addressId            String?
  // Identificação fiscal/operacional congelada. Uso restrito ao pedido;
  // nunca reutilizar estes snapshots para marketing.
  customerName         String
  customerEmail        String
  customerCpf          String?
  customerPhone        String?
  // Retrato imutável do destino no momento da compra. A relação com Address
  // continua opcional para conveniência, mas nunca é a fonte do histórico.
  shippingRecipient    String
  shippingZip          String
  shippingStreet       String
  shippingNumber       String
  shippingComplement   String?
  shippingDistrict     String
  shippingCity         String
  shippingState        String
  // Unidade que atende o pedido (roteada por CEP, matriz como fallback).
  // Nullable só por compatibilidade com a migração; sempre populada na criação.
  pharmacyId           String?
  notes                String?     @db.Text
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  // Arquivamento preserva o histórico fiscal/financeiro e é reversível.
  archivedAt           DateTime?

  user         User      @relation(fields: [userId], references: [id])
  address      Address?  @relation(fields: [addressId], references: [id], onDelete: SetNull)
  pharmacy     Pharmacy? @relation(fields: [pharmacyId], references: [id])
  // Entrega: entregador designado e marcos de saída/entrega.
  courierId    String?
  dispatchedAt DateTime?
  deliveredAt  DateTime?

  items                 OrderItem[]
  inventoryReservations InventoryReservation[]
  returnRequests        ReturnRequest[]
  deliveryProof         DeliveryProof?
  couponRedemption      CouponRedemption?
  payment               Payment?
  prescriptions         Prescription[]
  loyaltyTx             LoyaltyTransaction[]
  courier               Courier?               @relation(fields: [courierId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([pharmacyId])
  @@index([archivedAt, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  name      String
  price     Decimal @db.Decimal(12, 2)
  qty       Int

  order                Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  returnItems          ReturnItem[]
  inventoryReservation InventoryReservation?

  @@index([orderId])
}

model Payment {
  id                     String          @id @default(cuid())
  orderId                String          @unique
  provider               PaymentProvider @default(STRIPE)
  status                 PaymentStatus   @default(PENDING)
  externalId             String?
  refundId               String?         @unique
  refundError            String?         @db.Text
  refundRequestedAt      DateTime?
  refundedAt             DateTime?
  failureReason          String?         @db.Text
  failedAt               DateTime?
  lastReconciledAt       DateTime?
  reconciliationAttempts Int             @default(0)
  reconciliationError    String?         @db.Text
  amount                 Decimal         @db.Decimal(12, 2)
  raw                    Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  order  Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bankTx BankTransaction?
}

// ─────────────────────────── Receitas ───────────────────────────
model Prescription {
  id        String             @id @default(cuid())
  userId    String
  orderId   String?
  fileUrl   String             @db.Text
  status    PrescriptionStatus @default(PENDING)
  createdAt DateTime           @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ─────────────────────────── Fidelidade ───────────────────────────
model LoyaltyAccount {
  id           String               @id @default(cuid())
  userId       String               @unique
  points       Int                  @default(0)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id        String   @id @default(cuid())
  accountId String
  points    Int
  reason    String
  orderId   String?
  createdAt DateTime @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([accountId])
}

// ─────────────────────────── Marketing ───────────────────────────
model Coupon {
  id                    String             @id @default(cuid())
  code                  String             @unique
  type                  CouponType         @default(PERCENT)
  value                 Decimal            @db.Decimal(12, 2)
  minTotal              Decimal            @default(0) @db.Decimal(12, 2)
  expiresAt             DateTime?
  active                Boolean            @default(true)
  usageLimit            Int?
  usageLimitPerCustomer Int                @default(1)
  usedCount             Int                @default(0)
  redemptions           CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId, createdAt])
  @@index([userId, createdAt])
}

model Review {
  id               String   @id @default(cuid())
  productId        String
  userId           String
  rating           Int
  comment          String?  @db.Text
  // Moderação: avaliações só aparecem na loja após aprovação do dono.
  approved         Boolean  @default(false)
  verifiedPurchase Boolean  @default(false)
  createdAt        DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
}

// Lista de desejos por conta (sincroniza entre dispositivos do cliente).
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}

// ─────────────────────────── Unidades (Matriz + Filiais) ───────────────────────────
// Product guarda a curadoria canônica; Inventory contém a oferta e o estoque
// efetivos de cada unidade. Pedidos e escopo do admin também são por unidade.
model Pharmacy {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  type            PharmacyType @default(FILIAL)
  active          Boolean      @default(true)
  zip             String?
  street          String?
  number          String?
  district        String?
  city            String?
  state           String?
  phone           String?
  whatsapp        String?
  hours           String?
  // Frete por unidade: override do frete global (Setting). null = usa o global.
  shippingFlat    Decimal?     @db.Decimal(12, 2)
  shippingFreeMin Decimal?     @db.Decimal(12, 2)
  // Dados regulatórios (ANVISA) por unidade: override do global. null = global.
  cnpj            String?
  pharmacistName  String?
  pharmacistCrf   String?
  archivedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  inventory             Inventory[]
  inventoryLots         InventoryLot[]
  inventoryReservations InventoryReservation[]
  returnRequests        ReturnRequest[]
  cepRanges             PharmacyCepRange[]
  orders                Order[]
  users                 User[]
  carts                 Cart[]
  couriers              Courier[]
  expenses              Expense[]
  bankTx                BankTransaction[]

  @@index([type])
  @@index([active, archivedAt])
}

// ─────────────────────── Entregas ───────────────────────
/// Entregador da unidade. O pedido recebe um entregador ao sair para entrega;
/// o cliente acompanha pelo próprio número do pedido.
model Courier {
  id         String   @id @default(cuid())
  name       String
  phone      String?
  active     Boolean  @default(true)
  pharmacyId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id])
  orders   Order[]

  @@index([pharmacyId, active])
}

// ─────────────────── Financeiro gerencial ───────────────────
enum ExpenseCategory {
  RENT
  PAYROLL
  SUPPLIER
  MARKETING
  TAX
  UTILITIES
  OTHER
}

/// Despesa da operação — entra no DRE (resultado) e no DFC (saída de caixa).
model Expense {
  id          String          @id @default(cuid())
  pharmacyId  String?
  category    ExpenseCategory @default(OTHER)
  description String
  amount      Decimal         @db.Decimal(12, 2)
  paidAt      DateTime
  createdAt   DateTime        @default(now())

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id])

  @@index([paidAt])
  @@index([pharmacyId])
}

/// Lançamento do extrato bancário (importado por OFX/CSV). Quando casado com um
/// Payment, a linha está CONCILIADA (paymentId preenchido).
model BankTransaction {
  id          String   @id @default(cuid())
  pharmacyId  String?
  date        DateTime
  description String
  amount      Decimal  @db.Decimal(12, 2)
  /// Identificador do lançamento no extrato (FITID no OFX) — evita reimportar.
  externalId  String?  @unique
  paymentId   String?  @unique
  createdAt   DateTime @default(now())

  pharmacy Pharmacy? @relation(fields: [pharmacyId], references: [id])
  payment  Payment?  @relation(fields: [paymentId], references: [id])

  @@index([date])
  @@index([pharmacyId])
}

// Faixas de CEP atendidas por uma unidade (numéricas, 8 dígitos). O roteamento
// escolhe a primeira unidade cuja faixa contém o CEP; sem casar, a entrega é
// recusada (a matriz é fallback de navegação, não de cobertura logística).
model PharmacyCepRange {
  id         String    @id @default(cuid())
  pharmacyId String
  start      Int
  end        Int
  archivedAt DateTime?
  // Distância (km) da unidade até esta faixa de CEP — usada no frete por km.
  // null = distância desconhecida (cai no default do frete).
  km         Float?

  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@index([pharmacyId])
  @@index([archivedAt])
}

// Estoque de um produto numa unidade. Fonte da verdade do estoque (substitui
// Product.stock/minStock, mantidos como legado até a migração de limpeza).
model Inventory {
  id         String   @id @default(cuid())
  productId  String
  pharmacyId String
  stock      Int      @default(0)
  minStock   Int      @default(5)
  /// Oferta efetiva da unidade. null existe apenas durante transições/legado e
  /// usa o valor canônico do Product como fallback de leitura.
  price      Decimal? @db.Decimal(12, 2)
  costPrice  Decimal? @db.Decimal(12, 2)
  promoPrice Decimal? @db.Decimal(12, 2)
  /// Identificadores locais do PDV; são únicos dentro de cada unidade.
  sku        String?
  ean        String?
  /// Estoque máximo (nível de reposição). Base da sugestão de compra:
  /// quando stock <= minStock, sugere comprar (maxStock - stock).
  maxStock   Int?

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  pharmacy Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([productId, pharmacyId])
  @@unique([pharmacyId, sku])
  @@unique([pharmacyId, ean])
  @@index([pharmacyId])
  @@index([productId])
}

/// Livro razão imutável do estoque. Os identificadores e o e-mail do ator são
/// snapshots deliberados: o histórico sobrevive à anonimização e ao arquivamento
/// dos cadastros operacionais sem depender de relações mutáveis.
model InventoryMovement {
  id            String                @id @default(cuid())
  productId     String
  pharmacyId    String
  kind          InventoryMovementKind
  delta         Int
  stockBefore   Int
  stockAfter    Int
  reason        String                @db.Text
  referenceType String?
  referenceId   String?
  actorId       String?
  actorEmail    String?
  createdAt     DateTime              @default(now())

  @@index([productId, pharmacyId, createdAt])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

/// Lote físico por unidade. `qty` é o saldo rastreável do lote; estoque legado
/// sem lote permanece no Inventory e pode ser saneado gradualmente.
model InventoryLot {
  id         String   @id @default(cuid())
  productId  String
  pharmacyId String
  lotCode    String
  expiresAt  DateTime
  qty        Int
  supplier   String?
  note       String?  @db.Text
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product     Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  pharmacy    Pharmacy                  @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  allocations InventoryReservationLot[]
  returns     ReturnItem[]

  @@unique([productId, pharmacyId, lotCode])
  @@index([pharmacyId, expiresAt, qty])
  @@index([productId, pharmacyId])
}

/// Estoque comprometido por um pedido ainda não concluído. O saldo disponível
/// já é debitado na criação; esta linha torna a liberação/baixa idempotente.
model InventoryReservation {
  id          String                     @id @default(cuid())
  orderId     String
  orderItemId String                     @unique
  productId   String
  pharmacyId  String
  qty         Int
  status      InventoryReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  committedAt DateTime?
  releasedAt  DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  order       Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem                 @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product     Product                   @relation(fields: [productId], references: [id], onDelete: Restrict)
  pharmacy    Pharmacy                  @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  allocations InventoryReservationLot[]

  @@index([orderId, status])
  @@index([status, expiresAt])
  @@index([productId, pharmacyId, status])
}

/// Parcela da reserva atribuída a um lote FEFO. A soma pode ser menor que a
/// reserva quando parte do saldo ainda é legado e não possui lote rastreado.
model InventoryReservationLot {
  id            String @id @default(cuid())
  reservationId String
  lotId         String
  qty           Int

  reservation InventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  lot         InventoryLot         @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([reservationId, lotId])
  @@index([lotId])
}

/// Fluxo de pós-venda separado do status do pedido. O recebimento físico e a
/// reposição de estoque não dependem da liquidação financeira do estorno.
model ReturnRequest {
  id              String             @id @default(cuid())
  orderId         String
  userId          String
  pharmacyId      String
  status          ReturnStatus       @default(REQUESTED)
  reason          ReturnReason
  customerNotes   String?            @db.Text
  adminNotes      String?            @db.Text
  requestedAmount Decimal            @db.Decimal(12, 2)
  approvedAmount  Decimal?           @db.Decimal(12, 2)
  requestedAt     DateTime           @default(now())
  decidedAt       DateTime?
  receivedAt      DateTime?
  completedAt     DateTime?
  refundStatus    ReturnRefundStatus @default(PENDING)
  refundId        String?            @unique
  refundError     String?            @db.Text
  refundedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  order    Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  pharmacy Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Restrict)
  items    ReturnItem[]

  @@index([orderId, status])
  @@index([userId, createdAt])
  @@index([pharmacyId, status, createdAt])
}

/// Caixa de entrada idempotente dos webhooks Stripe. O payload é identificado
/// por hash, e tentativas/falhas ficam observáveis para reconciliação.
model StripeEvent {
  id            String            @id
  type          String
  payloadSha256 String
  status        StripeEventStatus @default(PROCESSING)
  attempts      Int               @default(1)
  lastError     String?           @db.Text
  receivedAt    DateTime          @default(now())
  processedAt   DateTime?
  updatedAt     DateTime          @updatedAt

  @@index([status, updatedAt])
  @@index([type, receivedAt])
}

/// Destino sanitário de um item devolvido. Medicamento que volta da casa do
/// cliente não retorna à prateleira por decisão automática: fica em quarentena
/// até alguém com responsabilidade decidir, e só volta ao LOTE de origem.
enum ReturnItemDisposition {
  /// Recebido fisicamente e em quarentena. NÃO conta como estoque vendável.
  PENDING
  /// Liberado pela conferência: voltou ao lote de origem e ao estoque.
  RESTOCKED
  /// Inutilizado. Nunca entrou no estoque, então não há o que baixar.
  DISCARDED
}

model ReturnItem {
  id              String   @id @default(cuid())
  returnRequestId String
  orderItemId     String
  qty             Int
  /// Quanto chegou fisicamente na conferência de recebimento.
  receivedQty     Int      @default(0)
  /// Quanto efetivamente voltou ao estoque vendável (só em RESTOCKED).
  restockQty      Int      @default(0)
  createdAt       DateTime @default(now())

  disposition      ReturnItemDisposition @default(PENDING)
  decidedAt        DateTime?
  decidedById      String?
  decidedByEmail   String?
  dispositionNotes String?               @db.Text
  /// Lote que recebeu a devolução de volta — o mesmo que a venda consumiu.
  restockLotId     String?

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  restockLot    InventoryLot? @relation(fields: [restockLotId], references: [id], onDelete: SetNull)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
  @@index([disposition])
}

/// Comprovante operacional imutável da entrega. Os nomes/e-mails são snapshots
/// para que a evidência não dependa de cadastros que podem mudar depois.
model DeliveryProof {
  id                     String              @id @default(cuid())
  orderId                String              @unique
  method                 DeliveryProofMethod
  recipientName          String
  recipientDocumentLast4 String?
  notes                  String?             @db.Text
  courierName            String?
  confirmedById          String?
  confirmedByEmail       String?
  createdAt              DateTime            @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// ─────────────────────────── Assinaturas ───────────────────────────
// Reposição recorrente de uso contínuo (sem cobrança automática): no vencimento
// o cron lembra o cliente por e-mail e o "Repor agora" leva à sacola em 1 clique.
// Produtos com receita ficam de fora (exigem validação farmacêutica a cada compra).
model Subscription {
  id             String             @id @default(cuid())
  userId         String
  productId      String
  qty            Int                @default(1)
  intervalDays   Int                @default(30)
  status         SubscriptionStatus @default(ACTIVE)
  nextDueAt      DateTime
  lastNotifiedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  notifications SubscriptionNotification[]

  @@unique([userId, productId])
  @@index([status, nextDueAt])
}

/// Caixa de saída durável dos lembretes de assinatura. A unicidade por ciclo
/// impede que duas execuções concorrentes do cron enviem o mesmo lembrete.
model SubscriptionNotification {
  id             String                     @id @default(cuid())
  subscriptionId String
  dueAt          DateTime
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  nextAttemptAt  DateTime                   @default(now())
  claimedAt      DateTime?
  sentAt         DateTime?
  lastError      String?                    @db.Text
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, dueAt])
  @@index([status, nextAttemptAt])
}

/// Caixa de saída durável para apagar documentos privados depois que a
/// transação de banco confirma a remoção dos dados pessoais correspondentes.
model StorageDeletionTask {
  id            String                @id @default(cuid())
  storageKey    String                @unique @db.Text
  status        StorageDeletionStatus @default(PENDING)
  attempts      Int                   @default(0)
  nextAttemptAt DateTime              @default(now())
  claimedAt     DateTime?
  completedAt   DateTime?
  lastError     String?               @db.Text
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status, nextAttemptAt])
}

// Trilha de auditoria das ações do admin. userEmail é um snapshot (sobrevive à
// exclusão/anonimização do usuário). Mutações críticas gravam a ação de forma
// síncrona; o erro é observável e nunca fica escondido em trabalho pós-resposta.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userEmail  String?
  action     String
  entity     String?
  entityId   String?
  detail     String?  @db.Text
  pharmacyId String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}

/// Lease de execução para jobs periódicos. Com o cron rodando de hora em hora
/// (e não mais uma vez por dia), duas execuções podem se sobrepor quando uma
/// demora; a lease garante que só uma trabalhe por vez, sem depender de lock de
/// sessão — que não sobrevive ao pool de conexões serverless.
model JobLease {
  name       String   @id
  holder     String
  acquiredAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

/// Estado da exportação de dados pessoais (LGPD art. 18 V).
enum DataExportStatus {
  PENDING
  READY
  FAILED
  EXPIRED
}

/// Pedido de portabilidade de dados. A geração é assíncrona: um titular antigo
/// tem histórico grande demais para montar dentro de uma requisição HTTP, e
/// tentar isso pressionava memória e tempo de resposta da loja inteira.
model DataExportRequest {
  id          String           @id @default(cuid())
  userId      String
  status      DataExportStatus @default(PENDING)
  /// Chave no storage PRIVADO. Nunca é exposta ao cliente: o download passa
  /// pela rota autenticada, que confere o dono antes de servir o conteúdo.
  storageKey  String?
  sizeBytes   Int?
  error       String?          @db.Text
  requestedAt DateTime         @default(now())
  readyAt     DateTime?
  /// Depois disto o arquivo é apagado do storage pela retenção.
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
}
