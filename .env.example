# Copie para .env e ajuste. NUNCA comite o .env real.

# Banco: PostgreSQL (Neon). Na Vercel, as duas variáveis abaixo são criadas
# automaticamente pela integração Storage → Neon. Localmente, copie do painel
# do Neon (console.neon.tech).
#  - DATABASE_URL: conexão "pooled" (com -pooler no host) — usada pela app.
#  - DATABASE_URL_UNPOOLED: conexão direta — usada pelo Prisma nas migrations.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/NOME?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/NOME?sslmode=require"

# OBRIGATÓRIA em build de produção — sem ela o servidor recusa subir, para que
# um deploy esquecido não fique sem os controles rígidos (TLS, rate limit
# durável, segredo de webhook). Valores aceitos: production, preview, staging,
# development, test. Na Vercel, VERCEL_ENV já é definido automaticamente.
APP_ENV="development"

# Auth.js — gere com: npx auth secret
AUTH_SECRET="troque-por-um-segredo-aleatorio"
# Raízes criptográficas independentes do Auth.js. Gere dois valores diferentes,
# aleatórios (>= 32 caracteres) e mantenha-os apenas no secret manager.
MFA_ENCRYPTION_KEY="troque-por-outra-chave-aleatoria"
MFA_RECOVERY_PEPPER="troque-por-outro-pepper-aleatorio"
# Rotação gradual: mova o valor antigo para *_PREVIOUS, publique o novo como
# atual e remova o anterior somente após o reenvelope/relogin dos administradores.
# MFA_ENCRYPTION_KEY_PREVIOUS=""
# MFA_RECOVERY_PEPPER_PREVIOUS=""
AUTH_TRUST_HOST="true"
# Apenas em deploy self-hosted atrás de proxy reverso que sobrescreve/anexa
# X-Forwarded-For. Na Vercel, o IP gerenciado é detectado automaticamente.
TRUST_PROXY_HEADERS="false"
# Opcional: fixa a URL pública do Auth.js (recomendado em produção/Vercel).
# Em http (sem TLS) defina http://... para desativar cookies "secure".
# AUTH_URL="https://seudominio.com.br"

# App — em produção use https:// (cookies seguros dependem disso)
NEXT_PUBLIC_APP_NAME="FarmaVida"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Stripe (Dashboard > Developers). Segredos ficam somente no secret manager.
# Opt-in: SOMENTE "true" liga a cobrança. Ausente, vazia ou escrita errada mantém
# cartão/Pix indisponíveis — dinheiro na entrega continua funcionando.
# Produção exige true ou false explícito.
PAYMENTS_ENABLED="false"
#  - STRIPE_SECRET_KEY: sk_test_… (teste) ou sk_live_… (produção).
#  - STRIPE_WEBHOOK_SECRET: signing secret do endpoint /api/webhooks/stripe (whsec_…).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Dados regulatórios da farmácia (exibidos no rodapé — exigência ANVISA).
NEXT_PUBLIC_PHARMACIST_NAME=""
NEXT_PUBLIC_PHARMACIST_CRF=""
NEXT_PUBLIC_CNPJ=""

# O restante da divulgação obrigatória (razão social, endereço, horário,
# telefone, licença sanitária, AFE e AE quando aplicável) é configurado em
# Admin → Configurações. Sem os campos obrigatórios, a loja se identifica
# publicamente como ambiente não liberado para operação comercial.

# Storage privado legado (receitas antigas; o canal não recebe novos arquivos).
# Use disabled somente se não existir acervo legado que precise ser servido ou
# excluído. Nesse modo toda tentativa de operação com arquivo falha fechado.
# - Local (default só em desenvolvimento): salva em UPLOAD_DIR ou
#   ./private-uploads. Em produção self-hosted, declare ambos e monte volume.
#   com volume persistente. NÃO funciona em serverless (FS efêmero).
# - S3/compatível (R2, MinIO, Spaces): defina STORAGE_DRIVER=s3 + as S3_*.
UPLOAD_DIR=""
STORAGE_DRIVER="disabled"   # produção: "disabled", "local" ou "s3"; Vercel não aceita "local"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""              # opcional (R2/MinIO/Spaces). Vazio = AWS S3.
S3_PREFIX=""                # opcional, prefixo das chaves (ex.: "farmavida/")

# Seed destrutivo — use apenas contra PostgreSQL local descartável. O comando
# recusa NODE_ENV/VERCEL_ENV=production e qualquer host que não seja loopback.
# ALLOW_DESTRUCTIVE_SEED="I_UNDERSTAND_THIS_WILL_DELETE_DATA"
# SEED_OWNER_PASSWORD=""   # vazio/ausente = senha aleatória impressa uma vez
# SEED_BRANCH_PASSWORD=""
# SEED_CUSTOMER_PASSWORD=""

# E2E com escrita — use OUTRO banco, criado para testes e descartável. A URL
# abaixo substitui DATABASE_URL somente no servidor iniciado pelo Playwright.
# Exige loopback e nome terminado em _test. Nunca copie a URL de produção.
# E2E_DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/farmavida_test"
# E2E_DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@localhost:5432/farmavida_test"
# E2E_ALLOW_WRITES="I_UNDERSTAND_THIS_IS_A_DISPOSABLE_DATABASE"

# Integração PostgreSQL: configure no terminal; detalhes em docs/DEVELOPMENT.md.
# INTEGRATION_DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/farmavida_test"
# INTEGRATION_ALLOW_WRITES="I_UNDERSTAND_THIS_IS_A_DISPOSABLE_DATABASE"

# E-mail transacional (Resend). Sem isso, os e-mails só são logados no console
# (dev). Opt-in: SOMENTE "true" envia de verdade; qualquer outro valor desliga.
# Produção exige true ou false explícito.
EMAIL_ENABLED="false"
# Com true, defina os dois valores abaixo para enviar de verdade.
# MAIL_FROM precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=""
MAIL_FROM="FarmaVida <nao-responda@seudominio.com.br>"

# Rate-limit durável (Upstash Redis, plano free: console.upstash.com).
# Sem as duas, o limite de tentativas (login/checkout/busca) é POR INSTÂNCIA —
# fraco na Vercel (some no cold start). Copie a REST URL e o token do painel do
# banco Redis. Confira com: npm run check:ratelimit
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Alternativa: a integração do Marketplace da Vercel (Storage → Upstash) injeta
# as credenciais com ESTES nomes. O código aceita os dois pares — não precisa
# definir os quatro, só um par.
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""
# Alternativa para Node/self-host: conexão TCP Redis. Prefira `rediss://` fora
# de rede privada. Não combine com os pares REST acima.
# REDIS_URL="rediss://USUARIO:SENHA@redis.exemplo:6379"

# Segredo dos crons de assinaturas e retenção (/api/cron/*). Na Vercel, defina a
# env CRON_SECRET (Settings → Environment Variables) — o agendador dela envia
# "Authorization: Bearer <CRON_SECRET>" automaticamente. Gere um valor aleatório.
# Protege assinaturas, retenção e a reconciliação de pagamentos/reservas.
CRON_SECRET=""

# Monitoramento (Sentry) — opcional. Sem DSN, fica desligado.
# SENTRY_DSN: erros de servidor; NEXT_PUBLIC_SENTRY_DSN: erros no navegador.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0"
